# The default demo uses MockDataProvider and needs no secrets.
# Copy only the variables required by your host-side DataProvider.

DATA_PROVIDER=mock
PROVIDER_CACHE_TTL_MS=30000
PROVIDER_RETRY_MAX_ATTEMPTS=3
PROVIDER_RETRY_BASE_DELAY_MS=100

# Optional host-injected Mapbox values for the auxiliary map module.
VITE_MAPBOX_ACCESS_TOKEN=
VITE_MAPBOX_STYLE_LIGHT=
VITE_MAPBOX_STYLE_DARK=
